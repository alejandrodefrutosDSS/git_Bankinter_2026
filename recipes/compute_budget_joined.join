  "computedColumns": [
    {
      "mode": "GREL",
      "name": "overBudgetUSD",
      "expr": "if(llmUsage_estimatedCostUSD_sum_sum - budgetUSD \u003e 0, llmUsage_estimatedCostUSD_sum_sum - budgetUSD, 0)",
      "type": "float"
    },
    {
      "mode": "GREL",
      "name": "isOverBudget",
      "expr": "if(llmUsage_estimatedCostUSD_sum_sum - budgetUSD \u003e 0, 1, 0)",
      "type": "int"
    },
    {
      "mode": "GREL",
      "name": "isUnderBudget",
      "expr": "if(llmUsage_estimatedCostUSD_sum_sum - budgetUSD \u003e 0, 0, 1)",
      "type": "int"
    },
    {
      "mode": "GREL",
      "name": "hasTwentyPercentBudgetLeft",
      "expr": "if(llmUsage_estimatedCostUSD_sum_sum \u003e\u003d 0.8 * budgetUSD \u0026\u0026 llmUsage_estimatedCostUSD_sum_sum \u003c\u003d budgetUSD, 1, 0)",
      "type": "int"
    }
  ],
