          "params": {
            "expression": "if(context_type \u003d\u003d \"JUPYTER_NOTEBOOK_KERNEL\", concat(\"JUPYTER Notebook : \", context_jupyterNotebookId),\nif(context_type \u003d\u003d \"WEBAPP_BACKEND\", concat(\"WEBAPP backend : \", context_webappId),\nif(contains(context_type, \"JOB\"), if(isBlank(context_activityId), \"Unknown context\", concat(\"Activity : \",  context_activityId)),\nif(context_type \u003d\u003d \"CONTINUOUS_ACTIVITY\", if(isNull(context_activityId), \"Unknown context\", concat(\"Continuous activity \",  context_activityId)),\nif(context_type \u003d\u003d \"ANALYSIS_ML_TRAIN\", concat(\"ML Training analysis : \",  context_analysisId, \" (TaskID : \", context_mlTaskId, \")\"),\nif(context_type \u003d\u003d \"EDA\", \"Visual Statistics computation\",\nif(context_type \u003d\u003d \"CONTINUOUS_ACTIVITY\", if(isNull(context_activityId), \"Unknown context\", concat(\"Continuous activity \",  context_activityId)),\nif(context_type \u003d\u003d \"SAVED_MODEL_OPERATION\", \"SAVED_MODEL_OPERATION\",\nif(context_type \u003d\u003d \"METRICS\", concat(\"METRICS on  : \", context_datasetName),\nif(contains(context_type, \"JOB_ACTIVITY\"), if(isBlank(context_activityId), \"Unknown context\", concat(\"Activity : \",  context_activityId)),\nif(isNonBlank(context_type), context_type,\n\"Unknown context\")))))))))))",
