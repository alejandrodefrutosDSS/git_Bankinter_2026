      {
        "id": "custom_python",
        "type": "custom_python",
        "name": "Update notifications dataset",
        "enabled": true,
        "alwaysShowComment": false,
        "runConditionType": "RUN_IF_STATUS_MATCH",
        "runConditionStatuses": [
          "SUCCESS",
          "WARNING"
        ],
        "runConditionExpression": "",
        "resetScenarioStatus": false,
        "delayBetweenRetries": 10,
        "maxRetriesOnFail": 0,
        "params": {
          "script": "# -*- coding: utf-8 -*-\nimport dataiku\nimport pandas as pd, numpy as np\nfrom dataiku import pandasutils as pdu\nfrom dataiku.scenario import Scenario\n\nbudget_joined_prepared \u003d dataiku.Dataset(\"budget_joined_prepared\")\nbudget_joined_prepared_df \u003d budget_joined_prepared.get_dataframe()\nover_budget_df \u003d budget_joined_prepared_df[\n    (budget_joined_prepared_df[\"isOverBudget\"] \u003d\u003d 1) | (budget_joined_prepared_df[\"hasTwentyPercentBudgetLeft\"] \u003d\u003d 1)]\nover_budget_df[\"overBudgetNotificationSent\"] \u003d False\nover_budget_df[\"twentyPercentLeftNotificationSent\"] \u003d False\n\nover_budget_notifications \u003d dataiku.Dataset(\"over_budget_notifications\")\ntry:\n    over_budget_notifications_df \u003d over_budget_notifications.get_dataframe()\nexcept:\n    over_budget_notifications_df \u003d None\n\n# keep track of notifications already sent.\nif over_budget_notifications_df is not None:\n    for index, row in over_budget_notifications_df.iterrows():\n        project_key \u003d row[\"projectKey\"]\n\n        over_budget_df.loc[\n            over_budget_df[\"projectKey\"] \u003d\u003d project_key, \"overBudgetNotificationSent\"\n        ] \u003d row[\"overBudgetNotificationSent\"]\n        over_budget_df.loc[\n            over_budget_df[\"projectKey\"] \u003d\u003d project_key, \"twentyPercentLeftNotificationSent\"\n        ] \u003d row[\"twentyPercentLeftNotificationSent\"]\n\nover_budget_notifications.write_with_schema(over_budget_df)",
          "envSelection": {
            "envMode": "INHERIT"
          },
          "proceedOnFailure": false
        }
      },
