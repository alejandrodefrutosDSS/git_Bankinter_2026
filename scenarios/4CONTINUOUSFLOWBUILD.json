        "params": {
          "script": "# -*- coding: utf-8 -*-\nimport dataiku\nimport pandas as pd, numpy as np\nfrom dataiku import pandasutils as pdu\nfrom dataiku.scenario import Scenario\n\nbudget_joined_prepared \u003d dataiku.Dataset(\"budget_joined_prepared\")\nbudget_joined_prepared_df \u003d budget_joined_prepared.get_dataframe()\nover_budget_df \u003d budget_joined_prepared_df[budget_joined_prepared_df[\"isOverBudget\"] \u003d\u003d 0]\nover_budget_df[\"mailNotificationSent\"] \u003d False\n\nover_budget_notifications \u003d dataiku.Dataset(\"over_budget_notifications\")\ntry:\n    over_budget_notifications_df \u003d over_budget_notifications.get_dataframe()\nexcept:\n    over_budget_notifications_df \u003d None\n\nif over_budget_notifications_df \u003d\u003d None:\n    # notifications dataset is empty, we fill it with all over budget projects.\n    if len(over_budget_df) \u003e 0:\n        over_budget_notifications.write_with_schema(over_budget_df)\nelse:\n    over_budget_df.set_index(\"projectKey\", inplace\u003dTrue)\n    for row in over_budget_notifications_df.iterrrows():\n        over_budget_df.loc[over_budget_df[\"projectKey\"] \u003d\u003d row[\"projectKey\"]]\n        over_budget_df[]\n    for budget_row in over_budget_df.iterrows():\n        print(\"toto\")\n        print(budget_row)",
